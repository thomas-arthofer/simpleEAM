    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "^7.0.0",
    "@mui/lab": "^7.0.0-beta.12",
    "@mui/material": "^7.0.0",
    "@mui/system": "^7.0.0",
    "@mui/x-date-pickers": "^8.7.0",
