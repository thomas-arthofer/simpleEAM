{
  "name": "nextgen-eam-client",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"if(process.env.npm_execpath && process.env.npm_execpath.indexOf('yarn') === -1) throw new Error('⚠️ Please use yarn for this project!')\"",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "set:token": "tsx scripts/set-token.ts",
    "import:json": "tsx scripts/import-json.ts",
    "import:demo-json": "tsx scripts/import-json.ts --file demos/NextGenEAM_Company-Solar_Panels_GmbH.json",
    "import:demo-json:dry-run": "tsx scripts/import-json.ts --file demos/NextGenEAM_Company-Solar_Panels_GmbH.json --dry-run"
  },
  "packageManager": "yarn@4.9.1",
  "dependencies": {
