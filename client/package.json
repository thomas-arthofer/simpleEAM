    "bpmn-js": "^17.11.1",
    "bpmn-moddle": "^10.0.0",
    "browser-fs-access": "0.29.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "fractional-indexing": "^3.2.0",
    "graphql": "^16.8.0",
    "html-to-image": "^1.11.13",
    "hyphenation.de": "^0.2.1",
    "hyphenation.en-us": "^0.2.1",
    "hypher": "^0.2.5",
    "js-sha256": "^0.11.1",
